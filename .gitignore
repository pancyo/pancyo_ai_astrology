**/*.keystore
**/*.jks
google-services.json
GoogleService-Info.plist

# Swiss Ephemeris: this app builds with Moshier calculations.  Optional
# ephemeris datasets, upstream binaries, and test fixtures are not bundled.
/third_party/swisseph/ephe/
/third_party/swisseph/bin/
/third_party/swisseph/setest/
/third_party/swisseph/windows/*.zip
/third_party/swisseph/contrib/**/*.zip
/third_party/swisseph/contrib/android/libs/
/third_party/swisseph/windows/programs/
/third_party/swisseph/doc/media/
/third_party/swisseph/doc/*.pdf
